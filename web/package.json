{
  "name": "isla-del-gato",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "models": "node scripts/gen-manifest.mjs",
    "og": "node scripts/og.mjs",
    "cv": "tsx scripts/gen-cv.ts",
    "predev": "npm run models && npm run og && npm run cv",
    "prebuild": "npm run models && npm run og && npm run cv",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "pretypecheck": "npm run models",
    "typecheck": "tsc -p tsconfig.world.json",
    "preverify": "npm run models && npm run cv",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "cannon-es": "^0.20.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/three": "^0.169.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "satori": "^0.33.4",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
